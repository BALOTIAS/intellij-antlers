<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.balotias.intellijantlers</id>
    <name>Antlers</name>
    <vendor email="balotamatthias@gmail.com" url="https://github.com/BALOTIAS/intellij-antlers">Matthias Balota</vendor>
    <description><![CDATA[
        <p>Full language support for <b>Statamic Antlers</b> templates
        (<code>*.antlers.html</code> and <code>*.antlers.php</code>) in IntelliJ-based IDEs.</p>

        <p>Antlers is parsed as a template language layered over HTML/CSS, so you get real Antlers
        intelligence inside <code>{{ }}</code> while keeping the regular HTML and CSS tooling in the
        surrounding markup. The plugin reads your project's <b>blueprints, fieldsets, collections,
        taxonomies, navigations, forms,</b> and a view's <b>YAML front matter</b>, so completion,
        navigation, and documentation are blueprint- and view-aware — and <b>scope-aware</b>: the
        variables offered and resolved are the ones actually available where your cursor is (inside a
        <code>{{ collection }}</code> loop, a related entry, a <code>{{ nav }}</code> tree, a
        <code>{{ form }}</code>, a page-mapped template, or an <code>@collection</code>-hinted view).</p>

        <p><b>Highlights</b></p>
        <ul>
            <li><b>Editing</b> — syntax highlighting with customizable colors; Antlers interpolation
            inside strings (<code>"object-position: {logo:focus_css}"</code>) highlighted as real
            Antlers; a view's <code>---</code>…<code>---</code> front matter editable as a real
            <b>YAML</b> island; brace matching, commenting, and <code>{{ }}</code> auto-insert; code
            folding; a <b>Structure view</b> outline; and <b>Template IDE hints</b>
            (<code>{{# @name / @collection / @blueprint … #}}</code>).</li>

            <li><b>Smart block editing</b> — completing a tag drops the caret where you'll type
            (a parameter slot, or straight into the block); <b>Tab</b> walks parameter slots and then
            the block; a single <b>Enter</b> expands an empty <code>{{ tag }}{{ /tag }}</code> to an
            indented body.</li>

            <li><b>Completion</b> — tags, tag methods/sub-tags, parameter names and <b>values</b>
            (partial paths, collection/taxonomy handles, sort fields, booleans), logic keywords,
            modifiers and their arguments (incl. inside conditions), colon shorthand
            (<code>{{ collection:&hellip; }}</code>), and variables (blueprint fields, system, loop,
            nav, form, <code>view:</code> front-matter keys, plus member/relationship completion when
            dotting into grid/group fields and related entries). Backed by a bundled <b>Statamic 5 &amp;
            6</b> catalog tailored to the version detected in your <code>composer.json</code>, extended
            by custom tags/modifiers discovered in your project.</li>

            <li><b>Navigation &amp; docs</b> — go to a variable's blueprint field, a partial file, a
            <code>view:</code> key, or a custom tag/modifier's PHP class (including the inline
            <code>{{ x = {your_tag &hellip;} }}</code> form); quick documentation on hover and
            parameter info for modifier arguments.</li>

            <li><b>Diagnostics</b> — a tag-balance annotator (unclosed/stray/ mismatched conditions and
            paired tags) that leaves unknown/addon tags alone, plus an unknown-modifier inspection.</li>

            <li><b>Refactoring</b> — Rename and Find Usages for partials and for blueprint field handles
            (the YAML <code>handle:</code> &harr; every <code>{{ &hellip; }}</code> usage).</li>

            <li><b>Formatting</b> — indentation-only Reformat Code designed to coexist with Prettier:
            normalizes spacing in <code>{{ }}</code>, indents tag/condition bodies, dedents
            <code>else</code>/<code>elseif</code>, bracket-nests multi-line arrays, and indents
            multi-line and template-named HTML tags. Configurable via <i>Code Style → Antlers</i>, with
            a toggle to defer entirely to Prettier.</li>

            <li><b>Convenience</b> — Antlers live templates and a <i>New → Antlers Template</i> action.</li>
        </ul>

        <p>Works with <b>Statamic 5 and 6</b> on the IntelliJ 2025.2 platform (IntelliJ IDEA, PhpStorm,
        WebStorm, and friends). PHP inside <code>{{$ &hellip; $}}</code> / <code>{{? &hellip; ?}}</code> and
        native <code>&lt;?php &hellip; ?&gt;</code> blocks is highlighted where the JetBrains PHP plugin is
        available (PhpStorm / IDEA Ultimate); everything else works everywhere.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- AntlersCatalogService is registered via the @Service annotation, not here. -->
        <fileType name="Antlers" implementationClass="com.github.balotias.intellijantlers.AntlersFileType" fieldName="INSTANCE" language="Antlers" patterns="*.antlers.html;*.antlers.php"/>
        
        <lang.parserDefinition language="Antlers" implementationClass="com.github.balotias.intellijantlers.parser.AntlersParserDefinition"/>
        <lang.ast.factory language="Antlers" implementationClass="com.github.balotias.intellijantlers.parser.AntlersASTFactory"/>
        <lang.documentationProvider language="Antlers" implementationClass="com.github.balotias.intellijantlers.documentation.AntlersDocumentationProvider"/>
        <lang.syntaxHighlighterFactory language="Antlers" implementationClass="com.github.balotias.intellijantlers.highlighting.AntlersSyntaxHighlighterFactory"/>
        <editorHighlighterProvider filetype="Antlers" implementationClass="com.github.balotias.intellijantlers.highlighting.AntlersEditorHighlighterProvider"/>
        <lang.fileViewProviderFactory language="Antlers" implementationClass="com.github.balotias.intellijantlers.template.AntlersFileViewProviderFactory"/>
        <completion.contributor language="Antlers" implementationClass="com.github.balotias.intellijantlers.completion.AntlersCompletionContributor"/>
        <codeInsight.parameterInfo language="Antlers" implementationClass="com.github.balotias.intellijantlers.completion.AntlersModifierParameterInfoHandler"/>
        <codeInsight.parameterInfo language="Antlers" implementationClass="com.github.balotias.intellijantlers.completion.AntlersPartialParameterInfoHandler"/>

        <lang.braceMatcher language="Antlers" implementationClass="com.github.balotias.intellijantlers.editor.AntlersBraceMatcher"/>
        <lang.commenter language="Antlers" implementationClass="com.github.balotias.intellijantlers.editor.AntlersCommenter"/>

        <typedHandler implementation="com.github.balotias.intellijantlers.editor.AntlersTypedHandler"/>
        <editorActionHandler action="EditorTab"
            implementationClass="com.github.balotias.intellijantlers.editor.AntlersParamTabHandler"/>
        <enterHandlerDelegate implementation="com.github.balotias.intellijantlers.editor.AntlersEnterHandler"/>

        <lang.foldingBuilder language="Antlers" implementationClass="com.github.balotias.intellijantlers.editor.AntlersFoldingBuilder"/>
        <annotator language="Antlers" implementationClass="com.github.balotias.intellijantlers.editor.AntlersBalanceAnnotator"/>
        <annotator language="Antlers" implementationClass="com.github.balotias.intellijantlers.editor.AntlersSemanticHighlightAnnotator"/>
        <annotator language="Antlers" implementationClass="com.github.balotias.intellijantlers.editor.AntlersStringInterpolationAnnotator"/>
        <annotator language="Antlers" implementationClass="com.github.balotias.intellijantlers.editor.AntlersHintAnnotator"/>
        <annotator language="Antlers" implementationClass="com.github.balotias.intellijantlers.editor.AntlersTemplateTagAttributeAnnotator"/>
        <daemon.highlightInfoFilter implementation="com.github.balotias.intellijantlers.editor.AntlersHtmlErrorFilter"/>
        <localInspection language="Antlers"
                         implementationClass="com.github.balotias.intellijantlers.inspection.AntlersUnknownModifierInspection"
                         shortName="AntlersUnknownModifier" displayName="Unknown Antlers modifier"
                         groupName="Antlers" enabledByDefault="true" level="WARNING"/>
        <lang.psiStructureViewFactory language="Antlers"
            implementationClass="com.github.balotias.intellijantlers.structure.AntlersStructureViewFactory"/>
        <lang.findUsagesProvider language="Antlers"
            implementationClass="com.github.balotias.intellijantlers.references.AntlersFindUsagesProvider"/>
        <referencesSearch implementation="com.github.balotias.intellijantlers.references.AntlersPartialReferenceSearcher"/>
        <referencesSearch implementation="com.github.balotias.intellijantlers.references.AntlersFieldReferenceSearcher"/>
        <renamePsiElementProcessor implementation="com.github.balotias.intellijantlers.references.AntlersFieldRenameProcessor"/>
        <postFormatProcessor implementation="com.github.balotias.intellijantlers.formatter.AntlersSpacingPostFormatProcessor"/>
        <postFormatProcessor implementation="com.github.balotias.intellijantlers.formatter.AntlersIndentProcessor"/>
        <lang.formatter language="Antlers" implementationClass="com.github.balotias.intellijantlers.formatter.AntlersHtmlFormattingModelBuilder"/>
        <langCodeStyleSettingsProvider implementation="com.github.balotias.intellijantlers.settings.AntlersLanguageCodeStyleSettingsProvider"/>
        <colorSettingsPage implementation="com.github.balotias.intellijantlers.highlighting.AntlersColorSettingsPage"/>
        <liveTemplateContext contextId="ANTLERS" implementation="com.github.balotias.intellijantlers.template.AntlersTemplateContextType"/>
        <defaultLiveTemplates file="liveTemplates/Antlers"/>
        <internalFileTemplate name="Antlers Template"/>
        <lang.elementManipulator forClass="com.github.balotias.intellijantlers.psi.AntlersFrontMatterBody"
            implementationClass="com.github.balotias.intellijantlers.editor.AntlersFrontMatterBodyManipulator"/>
        <lang.elementManipulator forClass="com.github.balotias.intellijantlers.psi.AntlersPhpBlockBody"
            implementationClass="com.github.balotias.intellijantlers.editor.AntlersPhpBlockBodyManipulator"/>
        <lang.elementManipulator forClass="com.github.balotias.intellijantlers.psi.AntlersStringLeaf"
            implementationClass="com.github.balotias.intellijantlers.editor.AntlersStringLeafManipulator"/>
        <multiHostInjector implementation="com.github.balotias.intellijantlers.injection.AntlersYamlInjector"/>
        <multiHostInjector implementation="com.github.balotias.intellijantlers.injection.AntlersPhpInjector"/>
        <multiHostInjector implementation="com.github.balotias.intellijantlers.injection.AntlersStringInterpolationInjector"/>

        <projectConfigurable parentId="language"
            id="com.github.balotias.intellijantlers.settings.AntlersSettingsConfigurable"
            displayName="Antlers"
            instance="com.github.balotias.intellijantlers.settings.AntlersSettingsConfigurable"/>
    </extensions>

    <actions>
        <action id="Antlers.CreateFile"
                class="com.github.balotias.intellijantlers.actions.CreateAntlersFileAction">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>
